<style>
.main-menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.main-menu ul li a {
    display: inline-block;
    padding: 10px 20px;
    text-decoration: none;
    background-color: #00aaff;
    color: white;
    border-radius: 5px;
    transition: background-color 0.3s;
}

.main-menu ul li a:hover {
    background-color: #0088cc;
}
</style>
</head>
